# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js

# ---------- Build output ----------
dist/
build/
*.tsbuildinfo

# ---------- SvelteKit generated ----------
.svelte-kit/

# ---------- Tauri ----------
src-tauri/target/
src-tauri/gen/
src-tauri/.tmp/
# Per-work-order build folders. One per agent, so two deploys never write to
# the same files (see Wait-DeployLock in sarkari_deploy/sarkariKaam.ps1).
.t9/
# Local scratch: diagnostics an agent wrote for itself, and the empty
# executables a deploy test leaves behind. Neither belongs in the history.
.t9deploy/
test_sarkari_sandbox/

# ---------- Rust ----------
**/*.rs.bk
Cargo.lock.orig

# ---------- Local app data (never commit user projects/transcripts) ----------
workspace-data/
*.t9proj/
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- Media / extracted audio (can be GBs) ----------
# NOTE: never ignore a bare `media/` - it also hides source folders such as
# Clipchamp_Bunny/src/lib/components/media/, which silently drops their
# Tailwind classes from the build (a whole directory the scanner cannot see).
# The extensions below already cover the multi-GB files.
/media/
cache/
*.mp4
!resource_Clipchamp/*.mp4
!Clipchamp_Bunny/public/assets/*.mp4
*.mkv
*.mov
*.webm
*.wav
*.m4a
*.mp3
*.aac

# ---------- Reverse-engineering evidence ----------
# Extracted vendor bundles: multi-MB, Microsoft-copyrighted, regenerated by
# Clipchamp Clone/evidence/extract-cache.mjs. The small JSON evidence files are
# committed on purpose; only the huge REA payloads are excluded.
Clipchamp Clone/evidence/web-assets/
Clipchamp Clone/evidence/rea-js-analysis.json
Clipchamp Clone/evidence/rea-big-bundles.json
WebClipchamp_Clone/


# ---------- Secrets ----------
.env
.env.*
!.env.example
gemini.jpg
groq.jpg
*_key.pem
*_key.pub
*.session
*.session-journal
telegram.session*

# ---------- Editor / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
HKCU/

# ---------- Logs & Temp ----------
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp_*.txt

# ---------- Test / coverage ----------
coverage/
*.lcov
.kilocode/
.kilo/
deepclonewebsite/

# The deploy ledger's own records: one JSON per deploy, plus latest.json
# which is overwritten every time. This is the runtime's history, not
# source, and committing it turns every deploy into a commit.
sarkari_deploy/records/
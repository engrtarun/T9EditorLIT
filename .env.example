# ─────────────────────────────────────────────────────────────────────────────
# T9EditorLIT — Environment Template
# Copy to `.env` and fill in real values. `.env` is git-ignored and will NEVER
# be committed.
#
# Both the Tauri app and the Go daemon (t9cloud) read this one file, so every
# secret lives in exactly one place.
# ─────────────────────────────────────────────────────────────────────────────

# ── t9cloud daemon (Go) ─────────────────────────────────────────────────────
# Only needed when you run the cloud worker daemon. The desktop app works
# without it — it just cannot transcribe.

# Listen address. MUST be loopback: the daemon holds cloud API keys and has no
# authentication, so it refuses to bind anything else.
T9CLOUD_ADDR=127.0.0.1:8787

# Concurrent cloud jobs. Keep this small — jobs are network-bound, and each
# in-flight chunk holds a file handle and a multipart buffer.
T9CLOUD_WORKERS=2

# Pending jobs before the daemon answers 429 and the client slows down.
T9CLOUD_QUEUE_CAPACITY=32

# Total tries per job including the first. 429 and 5xx are retried; 4xx is not.
T9CLOUD_MAX_ATTEMPTS=3

# First retry delay, doubling each attempt up to a 30s cap.
T9CLOUD_BASE_BACKOFF=1s

# Where the Telegram MTProto session lives. Losing this means an OTP prompt on
# every restart, so keep it out of temp directories.
T9CLOUD_SESSION_DIR=

# ── Cloud AI: Transcription (Chunk 2) ────────────────────────────────────────
# Groq Cloud — Whisper Large v3. Free key: https://console.groq.com/keys
GROQ_API_KEY=

GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# Groq rejects uploads over 25 MB, so Rust splits audio into chunks under this.
GROQ_MAX_CHUNK_MB=15

# ── Cloud AI: "Tarun Tone" analysis (Chunk 2) ───────────────────────────────
# Gemini detects fumbles, retakes, repeated lines, wrong examples and silence,
# and pre-marks them ✕ in the Cut Panel.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Telegram MTProto vault (Chunk 5) ────────────────────────────────────────
# From https://my.telegram.org — API ID / hash are NOT the same as the BotFather
# token, and the MTProto API allows multi-GB uploads, unlike the Bot API's 50 MB.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Phone number in international format, digits only, no "+".
TELEGRAM_PHONE=

# Target chat, channel username or id.
TELEGRAM_TARGET_CHAT=

# ── Local paths ─────────────────────────────────────────────────────────────
# Leave blank for the OS default. Everything T9EditorLIT writes — SQLite
# databases, extracted audio, thumbnails, Telegram sessions — lives here.
T9EDITOR_DATA_DIR=
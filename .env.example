# ─────────────────────────────────────────────────────────────
# T9EditorLIT — Environment Template
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and will NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ── Cloud AI: Transcription (Chunk 2) ──────────────────────────
# Groq Cloud — Whisper Large v3
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Model used for Hinglish/Hindi transcription
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# Max upload size per Groq request is 25 MB (free tier).
# Rust splits audio into chunks smaller than this (15 MB target).
GROQ_MAX_CHUNK_MB=15

# ── Cloud AI: "Tarun Tone" brain (Chunk 2) ─────────────────────
# Google Gemini — detects fumbles, retakes, repeated lines,
# wrong examples and silence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Telegram MTProto cloud vault (Chunk 5) ─────────────────────
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone number in international format, digits only
TELEGRAM_PHONE=
# Target chat/channel username or id
TELEGRAM_TARGET_CHAT=

# ── Local paths (leave blank for OS defaults) ───────────────────
# Where project data / SQLite files live.
T9EDITOR_DATA_DIR=
{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"
  },
  "start_url": { "url": "https://app.clipchamp.com/", "query": [] },
  "environment": {
    "viewport": { "width": 1600, "height": 900, "device_scale_factor": 1 },
    "color_scheme": "light"
  },
  "actions": [
    { "step_id": "load", "action": "wait_for_timeout", "duration_ms": 7000 },
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 2000 }
  ],
  "capture": {
    "after_each_step": ["screenshot", "accessibility"],
    "at_end": ["screenshot", "accessibility", "url"]
  }
}
